<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme. Color roles resolve through values-night/colors.xml;
         only the system-bar icon contrast differs from the light theme. -->
    <style name="Theme.ExpenseTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Clay typography: rounded Nunito everywhere -->
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.ExpenseRegister.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.ExpenseRegister.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.ExpenseRegister.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.ExpenseRegister.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.ExpenseRegister.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.ExpenseRegister.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.ExpenseRegister.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.ExpenseRegister.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.ExpenseRegister.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.ExpenseRegister.LabelSmall</item>

        <item name="android:statusBarColor">@color/app_bar_background</item>
        <item name="android:navigationBarColor">@color/md_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <item name="chipStyle">@style/Widget.ExpenseRegister.Chip</item>
        <item name="materialCardViewStyle">@style/Widget.ExpenseRegister.Card</item>
        <item name="cardViewStyle">@style/Widget.ExpenseRegister.CardViewLegacy</item>
        <item name="materialButtonStyle">@style/Widget.ExpenseRegister.Button</item>
        <item name="floatingActionButtonStyle">@style/Widget.ExpenseRegister.Fab</item>
        <item name="toolbarStyle">@style/Widget.ExpenseRegister.Toolbar</item>
    </style>
</resources>
