<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frag4item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorDivider"
    app:cardBackgroundColor="@color/colorCardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Left: type indicator bar -->
        <View
            android:id="@+id/frag4typebar"
            android:layout_width="4dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle"
            tools:backgroundTint="@color/colorSecondary" />

        <!-- Center: category + subcategory + date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/frag4category_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                tools:text="Food" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/frag4sub_category_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"
                    tools:text="Restaurant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textColor="@color/colorTextHint"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/frag4Mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"
                    tools:text="Cash" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right: amount -->
        <TextView
            android:id="@+id/frag4amount_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            tools:text="−₹500"
            tools:textColor="@color/red" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>