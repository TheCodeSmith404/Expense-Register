    <!-- Clay lighting system: single top-left light source.
         Primary highlight ellipse (~25%), secondary top-edge sheen (~10%),
         center dome (~9%), near-imperceptible body gradient (~7%/6%),
         soft inner shadow past 75% toward bottom-right (~12%). -->
    <color name="clay_inner_light">#40FFFFFF</color>
    <color name="clay_edge_light">#1AFFFFFF</color>
    <color name="clay_dome">#17FFFFFF</color>
    <color name="clay_grad_light">#12FFFFFF</color>
    <color name="clay_grad_dark">#10000000</color>
    <color name="clay_inner_dark">#1F46325A</color>

    <!-- Diagonal (X+Y) outer shadow, four stacked steps faking a 24-48dp blur;
         kept low-opacity so the shadow fades naturally instead of hugging -->
    <color name="clay_shadow_1">#0A8A6FB8</color>
    <color name="clay_shadow_2">#0D8A6FB8</color>
    <color name="clay_shadow_3">#108A6FB8</color>
    <color name="clay_shadow_4">#148A6FB8</color>

