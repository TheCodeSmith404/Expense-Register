    <!-- ===== Design system: "Clay Pastels" claymorphism palette (light) =====
         Multicolor pastels on a warm cream base: lilac primary, baby-blue
         secondary, mint tertiary/income, peach error/expense. -->

    <!-- Primary (lilac clay) -->
    <color name="md_primary">#6C5BC4</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#E7E0F9</color>
    <color name="md_on_primary_container">#33296B</color>

