<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== App bar ===== -->
    <style name="Widget.ExpenseRegister.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/app_bar_background</item>
        <item name="titleTextColor">@color/app_bar_content</item>
        <item name="subtitleTextColor">@color/app_bar_content_muted</item>
        <item name="titleTextAppearance">@style/TextAppearance.ExpenseRegister.ToolbarTitle</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.ExpenseRegister.Toolbar</item>
        <item name="android:theme">@style/ThemeOverlay.ExpenseRegister.Toolbar</item>
    </style>

    <style name="TextAppearance.ExpenseRegister.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Forces light icons (nav, overflow, menu text) on the branded app bar -->
    <style name="ThemeOverlay.ExpenseRegister.Toolbar" parent="ThemeOverlay.Material3.Toolbar.Surface">
        <item name="colorControlNormal">@color/app_bar_content</item>
        <item name="colorOnSurface">@color/app_bar_content</item>
        <item name="colorOnSurfaceVariant">@color/app_bar_content</item>
        <item name="actionMenuTextColor">@color/app_bar_content</item>
    </style>

    <!-- ===== Cards ===== -->
    <style name="Widget.ExpenseRegister.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>

    <!-- Legacy androidx.cardview.widget.CardView used by list items -->
    <style name="Widget.ExpenseRegister.CardViewLegacy" parent="CardView">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
    </style>

    <!-- ===== Chips (period filter) ===== -->
    <style name="Widget.ExpenseRegister.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="chipStrokeColor">@color/chip_stroke_color</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipMinTouchTargetSize">44dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <!-- ===== Buttons ===== -->
    <style name="Widget.ExpenseRegister.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.ExpenseRegister.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>

    <style name="Widget.ExpenseRegister.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- ===== FAB ===== -->
    <style name="Widget.ExpenseRegister.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="tint">?attr/colorOnPrimaryContainer</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ExpenseRegister.Fab</item>
    </style>

    <style name="ShapeAppearance.ExpenseRegister.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- ===== Form fields ===== -->
    <style name="Widget.ExpenseRegister.FieldLabel" parent="">
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.ExpenseRegister.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.ExpenseRegister.SelectorField" parent="">
        <item name="android:background">@drawable/bg_selector_field</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">44dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Segmented radio buttons (transaction type) -->
    <style name="Widget.ExpenseRegister.Segment" parent="">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_segment</item>
        <item name="android:textColor">@color/segment_text_color</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <!-- ===== Text helpers ===== -->
    <style name="Widget.ExpenseRegister.SectionTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Legacy styles kept for compatibility ===== -->
    <style name="text_view_style">
        <item name="android:layout_width">178dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="button_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>
</resources>
